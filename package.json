{
  "name": "emc2",
  "private": true,
  "version": "0.1.4",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-desktop.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-desktop.mjs",
    "start": "node scripts/launch-desktop.mjs",
    "test": "tsx --test server/*.test.ts desktop/*.test.ts src/*.test.tsx scripts/*.test.mjs",
    "dev:web": "concurrently -k \"node --watch-path=server --watch-path=shared --import tsx server/index.ts\" \"vite --host 127.0.0.1\"",
    "start:web": "node --import tsx server/index.ts",
    "package": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:dir": "npm run build && electron-builder --win --x64 --dir",
    "package:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "package:mac:dir": "npm run build && electron-builder --mac --dir --publish never",
    "check:desktop": "node scripts/launch-desktop.mjs --check-startup",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.1.0",
    "googleapis": "^160.0.0",
    "htmlparser2": "10.1.0",
    "iconsax-react": "^0.0.8",
    "imapflow": "^1.0.0",
    "mailparser": "^3.7.0",
    "nodemailer": "^10.0.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/mailparser": "^3.4.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^27.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "main": ".desktop/main.cjs",
  "description": "A keyboard-driven desktop inbox for all your email accounts.",
  "author": "Screen",
  "build": {
    "appId": "dev.screen.aggregate-mail",
    "productName": "Emc²",
    "directories": {
      "output": "release"
    },
    "files": [
      ".desktop/**",
      "dist/**",
      "package.json",
      "build/icon.png",
      "!**/{.env,.env.*,*.env,*.env.*,*.key,*.pem,*.p12,*.pfx,*.mobileprovision,*.sqlite,*.sqlite-*,*.db,*.db-*,key.protected}",
      "!**/{.data,.handoff,.ssh,.aws}/**"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "notarize": false,
      "artifactName": "Emc²-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Emc²-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "Emc²-${version}-linux-${arch}.${ext}"
    }
  }
}
